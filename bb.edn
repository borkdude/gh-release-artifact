{:deps {current/project {:local/root "."}
        io.github.borkdude/quickdoc {:git/url "https://github.com/borkdude/quickdoc"
                                     :git/sha "b290f60fd68380485b613c711d98bea172f2f221"}}
 :tasks {quickdoc
         {:task (exec 'quickdoc.api/quickdoc)
          :exec-args {:git/branch "main"
                      :github/repo "https://github.com/borkdude/gh-release-artifact"}}
         test
         {:doc "Run the tests. They stub the Github calls, so no token is needed."
          :extra-paths ["test"]
          :requires ([borkdude.gh-release-artifact-test]
                     [clojure.test :as t])
          :task (let [{:keys [fail error]} (t/run-tests 'borkdude.gh-release-artifact-test)]
                  (when (pos? (+ fail error)) (System/exit 1)))}
         smoke
         {:doc "Upload to a real draft release. Needs GITHUB_TOKEN with write access. Takes org/repo, default borkdude/test-repo."
          :extra-paths ["script"]
          :requires ([smoke])
          :task (apply smoke/-main *command-line-args*)}}}
